---
import Layout from "../layouts/Layout.astro"
import AboutView from "../views/about.jsx"
import { buildProfilePageSchema, buildBreadcrumbSchema } from "../utils/schema"
---

<Layout
  titleOverride="About Rahul Tailor — Senior Frontend Developer"
  description="Senior Frontend Developer with 6+ years in React, Next.js and Webflow, working remotely with product teams across Canada, the US, and Europe."
  pathname="/about/"
  structuredData={[
    buildProfilePageSchema(),
    buildBreadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "About", path: "/about/" },
    ]),
  ]}
>
  <AboutView client:load />
</Layout>
