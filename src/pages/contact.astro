---
import Layout from "../layouts/Layout.astro"
import ContactView from "../views/contact.jsx"
import { buildContactPageSchema, buildBreadcrumbSchema } from "../utils/schema"
---

<Layout
  titleOverride="Contact Rahul Tailor — Senior Frontend Developer"
  description="Get in touch with Rahul Tailor, a senior frontend developer working with teams in Canada, the US, and Europe on React, Next.js, Webflow and HubSpot builds."
  pathname="/contact/"
  structuredData={[
    buildContactPageSchema(),
    buildBreadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "Contact", path: "/contact/" },
    ]),
  ]}
>
  <ContactView client:load />
</Layout>
