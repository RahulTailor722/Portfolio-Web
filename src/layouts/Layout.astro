---
import { ClientRouter } from "astro:transitions"
import Cursor from "../components/cursor.jsx"
import SmoothScroll from "../components/smooth-scroll.jsx"
import GsapAnimations from "../components/gsap-animations.jsx"
import PreloaderGate from "../components/preloader-gate.jsx"
import Navbar from "../components/navbar.jsx"
import Footer from "../components/footer.jsx"
import ScrollToTop from "../components/scroll-to-top.jsx"
import { PERSON } from "../utils/schema"

// Self-hosted fonts (latin subset only) — replaces the render-blocking
// Google Fonts <link>. Bundled + hashed by Astro, served from /_astro with a
// 1-year immutable cache. Family names ("Inter", "Space Grotesk", "Space
// Mono") match the --font-* tokens in global.css, so nothing else changes.
import "@fontsource/space-grotesk/latin-400.css"
import "@fontsource/space-grotesk/latin-500.css"
import "@fontsource/space-grotesk/latin-600.css"
import "@fontsource/space-grotesk/latin-700.css"
import "@fontsource/inter/latin-400.css"
import "@fontsource/inter/latin-500.css"
import "@fontsource/inter/latin-600.css"
import "@fontsource/inter/latin-700.css"
import "@fontsource/space-mono/latin-400.css"
import "@fontsource/space-mono/latin-700.css"
import "../styles/global.css"

// Preload the three faces used above the fold (h1/eyebrow/body) so they're
// fetched in parallel with the CSS instead of after it — the font swap then
// lands before first paint, killing the hero CLS the old chain caused.
import sgrotesk600Url from "@fontsource/space-grotesk/files/space-grotesk-latin-600-normal.woff2?url"
import sgrotesk500Url from "@fontsource/space-grotesk/files/space-grotesk-latin-500-normal.woff2?url"
import inter400Url from "@fontsource/inter/files/inter-latin-400-normal.woff2?url"

// SEO defaults. The <title> leads with what people search for ("senior
// frontend developer") rather than the brand — "Rahul Tailor" already wins its
// own name, so spending the first 30 characters on it targets nothing.
const SITE_URL = "https://rahultailor.com"
const DEFAULT_TITLE = "Senior Frontend Developer — React & Webflow | Rahul Tailor"
const DEFAULT_DESC =
  "Rahul Tailor is a Senior Frontend Developer with 6+ years of experience crafting fast, accessible, and delightful digital products."
const DEFAULT_IMAGE = `${SITE_URL}/images/og-default.jpg`

const {
  title,
  // Full <title> when the `${title} — Rahul Tailor` pattern would read badly
  // or blow past ~60 characters (case studies, keyword-led page titles).
  titleOverride,
  description,
  image,
  pathname = "/",
  type = "website",
  structuredData,
} = Astro.props

const fullTitle = titleOverride || (title ? `${title} — Rahul Tailor` : DEFAULT_TITLE)
const desc = description || DEFAULT_DESC
const ogImage = image ? `${SITE_URL}${image}` : DEFAULT_IMAGE
const ogImageWidth = image ? "1600" : "1200"
const ogImageHeight = image ? "1000" : "630"
const canonical = `${SITE_URL}${pathname}`

// The Person entity (with `areaServed` + `workLocation`) now lives in
// utils/schema.js so /about can reuse the identical object as its ProfilePage
// mainEntity. Still no hreflang on purpose — there is one English version of
// every page, and hreflang without genuinely localised alternates is noise.
const personSchema = PERSON

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Rahul Tailor",
  url: SITE_URL,
  inLanguage: "en",
  publisher: { "@type": "Person", name: "Rahul Tailor" },
}

const extraSchemas = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : []
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0b0c" />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={ogImageWidth} />
    <meta property="og:image:height" content={ogImageHeight} />
    <meta property="og:site_name" content="Rahul Tailor" />
    <!-- One English page serving several English-speaking markets. Too weak to
         justify hreflang, but `og:locale:alternate` costs nothing and states
         the intent for the crawlers and social scrapers that do read it. -->
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="en_CA" />
    <meta property="og:locale:alternate" content="en_GB" />
    <meta property="og:locale:alternate" content="en_IE" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href={sgrotesk600Url} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sgrotesk500Url} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter400Url} as="font" type="font/woff2" crossorigin />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {extraSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- SPA-style navigation: keeps the in-memory preloader flag alive so
         internal links play the short curtain, exactly like the Gatsby build. -->
    <ClientRouter />
  </head>
  <body>
    <!-- First focusable thing on the page, before every island, so a keyboard
         user reaches it on the very first Tab. Styled in global.css. -->
    <a class="skip-link" href="#main">Skip to content</a>
    <!-- All islands hydrate on load. Deferring Cursor/ScrollToTop to `idle`
         and Footer to `visible` was tried as a first-paint optimisation and
         reverted: it changes when islands finish hydrating, and the GSAP
         engine's timing depends on that. Not worth risking the animations for
         a few KB off the critical path. -->
    <Cursor client:load />
    <SmoothScroll client:load />
    <GsapAnimations client:load pathname={pathname} />
    <PreloaderGate client:load />
    <Navbar client:load />
    <main id="main"><slot /></main>
    <Footer client:load year={new Date().getFullYear()} />
    <ScrollToTop client:load />
  </body>
</html>
