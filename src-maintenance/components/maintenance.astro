---
/**
 * The maintenance screen. Rendered by Layout.astro in place of every page's
 * content while MAINTENANCE_MODE is on.
 *
 * Deliberate constraints:
 *   - No <a> elements at all. A link is a route out; there is nowhere to go.
 *   - No email, phone, form, or social handle anywhere on the page.
 *   - No React island, no GSAP, no Lenis. Pure server-rendered markup plus a
 *     scoped stylesheet, so the screen paints even if every script fails.
 *   - Colours, fonts and shapes come from the same tokens the live site uses
 *     (--bg / --accent / --font-display), so it reads as the same brand.
 */
const year = new Date().getFullYear()
---

<div class="wrap">
  <div class="grid" aria-hidden="true"></div>
  <div class="blob" aria-hidden="true"></div>
  <span class="watermark" aria-hidden="true">MAINTENANCE</span>

  <div class="inner">
    <svg
      class="mark"
      width="56"
      height="56"
      viewBox="0 0 100 100"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-label="Rahul Tailor"
    >
      <rect width="100" height="100" rx="20" fill="#c6f135"></rect>
      <text x="50" y="64" font-family="'Space Grotesk',system-ui,sans-serif" font-size="44" font-weight="700" fill="#0b0b0c" text-anchor="middle">RT</text>
    </svg>

    <p class="eyebrow"><span class="dot"></span>Status — Under Maintenance</p>

    <h1 class="title">We&rsquo;ll be back<br /><span class="accent">shortly.</span></h1>

    <p class="desc">
      The site is temporarily offline while it is being updated and improved.
      Nothing is broken on your end &mdash; please check back a little later.
    </p>

    <div class="bar" role="presentation"><span class="fill"></span></div>

    <p class="foot">&copy; {year} Rahul Tailor &middot; Senior Frontend Developer</p>
  </div>
</div>

<style>
  .wrap {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 5rem 0;
    background: var(--bg);
  }

  /* Same 64px lattice used by the 404 screen, masked to a soft ellipse so it
     fades out well before the viewport edge. */
  .grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 45%, black 15%, transparent 78%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 45%, black 15%, transparent 78%);
    opacity: 0.4;
    pointer-events: none;
  }

  .blob {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 70vw;
    height: 70vw;
    max-width: 820px;
    max-height: 820px;
    transform: translate(-50%, -55%);
    background: radial-gradient(circle, rgba(198, 241, 53, 0.13), transparent 65%);
    filter: blur(20px);
    pointer-events: none;
  }

  /* Outlined watermark, matching the page-header treatment used site-wide. */
  .watermark {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-display);
    font-size: clamp(4rem, 15vw, 15rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(244, 244, 239, 0.06);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }

  .inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: center;
  }

  .mark {
    display: block;
    margin: 0 auto 2rem;
    border-radius: 12px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent);
    animation: pulse 2s var(--ease) infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.35;
      transform: scale(0.8);
    }
  }

  .title {
    font-family: var(--font-display);
    /* 1.08 minimum: anything tighter clips descenders on the display face. */
    line-height: 1.1;
    font-size: clamp(2.6rem, 8vw, 4.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--fg);
    margin-bottom: 1.5rem;
  }

  .accent {
    color: var(--accent);
  }

  .desc {
    font-family: var(--font-body);
    color: var(--muted);
    font-size: clamp(1rem, 1.6vw, 1.1rem);
    line-height: 1.65;
    max-width: 46ch;
    margin: 0 auto 2.75rem;
  }

  /* Indeterminate progress sweep — decorative only, it tracks nothing. */
  .bar {
    position: relative;
    width: min(280px, 70%);
    height: 3px;
    margin: 0 auto 3rem;
    border-radius: 99px;
    background: var(--line);
    overflow: hidden;
  }

  .fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 40%;
    border-radius: 99px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    animation: sweep 2.4s var(--ease) infinite;
  }

  @keyframes sweep {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(350%);
    }
  }

  .foot {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-dark);
  }

  /* Both loops here run forever, so they are the case WCAG 2.2.2 is about. */
  @media (prefers-reduced-motion: reduce) {
    .dot,
    .fill {
      animation: none;
    }
    .fill {
      width: 100%;
      background: var(--accent-dim);
      opacity: 0.6;
    }
  }

  @media (max-width: 639px) {
    .watermark {
      font-size: 22vw;
    }
  }
</style>
